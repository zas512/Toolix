---
// Layout-stable 0-CLS horizontal banner placeholder
---

<!-- Ad Banner: 90px desktop / 50px mobile — fixed container prevents layout shift -->
<div class="w-full bg-[var(--color-bg-alt)] border border-[var(--color-border)] rounded-lg overflow-hidden" aria-label="Advertisement" role="region">
  <div class="min-h-[50px] sm:min-h-[90px] flex items-center justify-center px-6 py-3">
    <span class="text-xs text-[var(--color-text-secondary)] uppercase tracking-widest">Advertisement</span>
  </div>
</div>
