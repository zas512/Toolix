---
// PDF merge, split, compress component
---

<div class="space-y-8">
  {/* Header */}
  <div class="bg-[var(--color-bg)] rounded-xl p-6 sm:p-8 space-y-4">
    <h2 class="text-lg font-medium text-[var(--color-text)]">PDF Tools</h2>
    <p class="text-sm text-[var(--color-text-secondary)]">
      100% client-side processing • No uploads • Zero privacy risk
    </p>
  </div>

  {/* Tabs for operations */}
  <div class="bg-[var(--color-bg)] rounded-xl p-6 sm:p-8">
    <div class="flex border-b border-[var(--color-border)]">
      <button
        type="button"
        id="tab-merge"
        class="flex-1 px-4 py-3 text-sm font-medium text-[var(--color-text)] border-b-2 border-[var(--color-accent)] transition-colors"
        aria-selected="true"
        data-tab="merge"
      >
        Merge PDFs
      </button>
      <button
        type="button"
        id="tab-split"
        class="flex-1 px-4 py-3 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text)] border-b-2 border-transparent hover:border-[var(--color-accent)] transition-colors"
        aria-selected="false"
        data-tab="split"
      >
        Split PDF
      </button>
      <button
        type="button"
        id="tab-compress"
        class="flex-1 px-4 py-3 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text)] border-b-2 border-transparent hover:border-[var(--color-accent)] transition-colors"
        aria-selected="false"
        data-tab="compress"
      >
        Compress PDF
      </button>
    </div>

    {/* Tab panels */}
    <div class="pt-6">
      <div id="tab-merge-panel" class="space-y-4">
        <div class="border-2 border-dashed border-[var(--color-border)] rounded-xl p-8 text-center hover:border-[var(--color-accent)] transition-colors cursor-pointer" id="merge-dropzone">
          <input type="file" id="merge-file-input" accept=".pdf" multiple class="hidden" />
          <label for="merge-file-input" class="cursor-pointer block">
            <svg class="h-8 w-8 mx-auto text-[var(--color-text-secondary)] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <p class="text-sm font-medium text-[var(--color-text)]">Choose PDF files to merge</p>
            <p class="text-xs text-[var(--color-text-secondary)] mt-1">Select 2 or more PDFs</p>
          </label>
        </div>
        <div id="merge-file-list" class="text-xs text-[var(--color-text-secondary)]"></div>
        <button type="button" id="btn-merge-action" class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors w-full sm:w-auto" disabled>
          Merge PDFs
        </button>
      </div>

      <div id="tab-split-panel" class="hidden space-y-4">
        <div class="border-2 border-dashed border-[var(--color-border)] rounded-xl p-8 text-center hover:border-[var(--color-accent)] transition-colors cursor-pointer" id="split-dropzone">
          <input type="file" id="split-file-input" accept=".pdf" class="hidden" />
          <label for="split-file-input" class="cursor-pointer block">
            <svg class="h-8 w-8 mx-auto text-[var(--color-text-secondary)] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-sm font-medium text-[var(--color-text)]">Choose a PDF file to split</p>
            <p class="text-xs text-[var(--color-text-secondary)] mt-1" id="split-file-name">Extract specific pages</p>
          </label>
        </div>
        <div>
          <label for="split-pages" class="block text-sm font-medium mb-1">Page numbers or ranges (e.g. 1-3, 5)</label>
          <input type="text" id="split-pages" placeholder="1-3, 5" class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] px-4 py-2.5 text-sm" />
        </div>
        <button type="button" id="btn-split-action" class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors w-full sm:w-auto" disabled>
          Split PDF
        </button>
      </div>

      <div id="tab-compress-panel" class="hidden space-y-4">
        <div class="border-2 border-dashed border-[var(--color-border)] rounded-xl p-8 text-center hover:border-[var(--color-accent)] transition-colors cursor-pointer" id="compress-dropzone">
          <input type="file" id="compress-file-input" accept=".pdf" class="hidden" />
          <label for="compress-file-input" class="cursor-pointer block">
            <svg class="h-8 w-8 mx-auto text-[var(--color-text-secondary)] mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <p class="text-sm font-medium text-[var(--color-text)]">Choose a PDF file to compress</p>
            <p class="text-xs text-[var(--color-text-secondary)] mt-1" id="compress-file-name">Optimize PDF size</p>
          </label>
        </div>
        <div>
          <label for="compress-level" class="block text-sm font-medium mb-1">Compression Level</label>
          <select id="compress-level" class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] px-4 py-2.5 text-sm">
            <option value="low">Basic compression (highest quality)</option>
            <option value="medium" selected>Standard compression (recommended)</option>
            <option value="high">Strong compression (smaller size)</option>
          </select>
        </div>
        <button type="button" id="btn-compress-action" class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors w-full sm:w-auto" disabled>
          Compress PDF
        </button>
      </div>
    </div>
  </div>

  {/* Results area */}
  <div id="results" class="hidden bg-[var(--color-bg)] rounded-xl p-6 sm:p-8">
    <h2 class="text-lg font-medium mb-4 text-[var(--color-text)]">Results</h2>
    <div id="result-content">
      <!-- Populated by JS -->
    </div>
    <div class="mt-4">
      <button
        id="download-btn"
        type="button"
        class="inline-flex items-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors"
        disabled
      >
        <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1M5 10l5 5m0 0l5-5m-5 5V3a9 9 0 0118 0v5"/>
        </svg>
        Download
      </button>
    </div>
  </div>
</div>

<script type="module">
let worker = null;
let currentTab = 'merge';
const mergePanel = document.getElementById('tab-merge-panel');
const splitPanel = document.getElementById('tab-split-panel');
const compressPanel = document.getElementById('tab-compress-panel');
const mergeBtn = document.getElementById('tab-merge');
const splitBtn = document.getElementById('tab-split');
const compressBtn = document.getElementById('tab-compress');
const resultsDiv = document.getElementById('results');
const resultContent = document.getElementById('result-content');
const downloadBtn = document.getElementById('download-btn');

const mergeInput = document.getElementById('merge-file-input');
const splitInput = document.getElementById('split-file-input');
const compressInput = document.getElementById('compress-file-input');
const btnMergeAction = document.getElementById('btn-merge-action');
const btnSplitAction = document.getElementById('btn-split-action');
const btnCompressAction = document.getElementById('btn-compress-action');
const mergeFileList = document.getElementById('merge-file-list');
const splitFileName = document.getElementById('split-file-name');
const compressFileName = document.getElementById('compress-file-name');

let mergeFiles = [];
let splitFile = null;
let compressFile = null;

// Initialize worker
function initWorker() {
  if (!worker) {
    worker = new Worker(new URL('../../lib/pdf-worker.ts', import.meta.url), { type: 'module' });
    worker.onmessage = handleWorkerMessage;
  }
}

// Handle worker responses
function handleWorkerMessage(e) {
  const { type, payload } = e.data;

  if (type === 'ready') {
    // Worker is ready
  }

  if (type === 'result') {
    const blob = new Blob([payload.data], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);

    resultContent.innerHTML = `
      <div class="space-y-4">
        <p class="text-sm text-[var(--color-text)]">
          PDF processed successfully! Size: ${(payload.size / 1024).toFixed(1)} KB
        </p>
        <a href="${url}" download="processed.pdf"
           class="inline-flex items-center px-4 py-2 bg-[var(--color-bg-alt)] rounded hover:bg-[var(--color-border)] transition-colors text-sm">
          <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 15h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v5a2 2 0 002 2z"/>
          </svg>
          View PDF
        </a>
        <button
          id="download-btn-actual"
          type="button"
          class="inline-flex items-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors mt-2"
          download="processed.pdf"
        >
          <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1M5 10l5 5m0 0l5-5m-5 5V3a9 9 0 0118 0v5"/>
          </svg>
          Download PDF
        </button>
      </div>
    `;

    const actualDownloadBtn = resultContent.querySelector('#download-btn-actual');
    if (actualDownloadBtn) {
      actualDownloadBtn.onclick = () => {
        const link = document.createElement('a');
        link.href = url;
        link.download = 'processed.pdf';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      };
    }

    resultsDiv.classList.remove('hidden');
    downloadBtn.disabled = true;
  }

  if (type === 'error') {
    resultContent.innerHTML = `
      <div class="bg-red-50 border-l-4 border-red-200 p-4">
        <p class="text-sm text-red-600 font-medium">Error:</p>
        <p class="text-sm text-red-500">${payload.message}</p>
      </div>
    `;
    resultsDiv.classList.remove('hidden');
    downloadBtn.disabled = true;
  }
}

// File selection listeners
mergeInput?.addEventListener('change', () => {
  if (mergeInput.files) {
    mergeFiles = Array.from(mergeInput.files);
    mergeFileList.textContent = mergeFiles.map(f => f.name).join(', ');
    btnMergeAction.disabled = mergeFiles.length < 2;
  }
});

splitInput?.addEventListener('change', () => {
  if (splitInput.files && splitInput.files[0]) {
    splitFile = splitInput.files[0];
    splitFileName.textContent = splitFile.name;
    btnSplitAction.disabled = false;
  }
});

compressInput?.addEventListener('change', () => {
  if (compressInput.files && compressInput.files[0]) {
    compressFile = compressInput.files[0];
    compressFileName.textContent = compressFile.name;
    btnCompressAction.disabled = false;
  }
});

btnMergeAction?.addEventListener('click', () => {
  initWorker();
  worker.postMessage({ type: 'merge', payload: { count: mergeFiles.length } });
});

btnSplitAction?.addEventListener('click', () => {
  initWorker();
  worker.postMessage({ type: 'merge', payload: { file: splitFile?.name } });
});

btnCompressAction?.addEventListener('click', () => {
  initWorker();
  worker.postMessage({ type: 'merge', payload: { file: compressFile?.name } });
});

// Tab switching
mergeBtn.addEventListener('click', () => {
  currentTab = 'merge';
  mergeBtn.setAttribute('aria-selected', 'true');
  splitBtn.setAttribute('aria-selected', 'false');
  compressBtn.setAttribute('aria-selected', 'false');
  mergeBtn.classList.add('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  mergeBtn.classList.remove('text-[var(--color-text-secondary)]', 'border-transparent');
  splitBtn.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  splitBtn.classList.add('text-[var(--color-text-secondary)]', 'border-transparent');
  compressBtn.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  compressBtn.classList.add('text-[var(--color-text-secondary)]', 'border-transparent');

  mergePanel.classList.remove('hidden');
  splitPanel.classList.add('hidden');
  compressPanel.classList.add('hidden');
});

splitBtn.addEventListener('click', () => {
  currentTab = 'split';
  mergeBtn.setAttribute('aria-selected', 'false');
  splitBtn.setAttribute('aria-selected', 'true');
  compressBtn.setAttribute('aria-selected', 'false');
  mergeBtn.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  mergeBtn.classList.add('text-[var(--color-text-secondary)]', 'border-transparent');
  splitBtn.classList.add('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  splitBtn.classList.remove('text-[var(--color-text-secondary)]', 'border-transparent');
  compressBtn.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  compressBtn.classList.add('text-[var(--color-text-secondary)]', 'border-transparent');

  mergePanel.classList.add('hidden');
  splitPanel.classList.remove('hidden');
  compressPanel.classList.add('hidden');
});

compressBtn.addEventListener('click', () => {
  currentTab = 'compress';
  mergeBtn.setAttribute('aria-selected', 'false');
  splitBtn.setAttribute('aria-selected', 'false');
  compressBtn.setAttribute('aria-selected', 'true');
  mergeBtn.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  mergeBtn.classList.add('text-[var(--color-text-secondary)]', 'border-transparent');
  splitBtn.classList.remove('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  splitBtn.classList.add('text-[var(--color-text-secondary)]', 'border-transparent');
  compressBtn.classList.add('border-[var(--color-accent)]', 'text-[var(--color-text)]');
  compressBtn.classList.remove('text-[var(--color-text-secondary)]', 'border-transparent');

  mergePanel.classList.add('hidden');
  splitPanel.classList.add('hidden');
  compressPanel.classList.remove('hidden');
});

// Initialize on load
initWorker();
</script>

<style>
  /* Tab button styling */
  button[aria-selected="true"] {
    font-weight: 600;
  }
</style>