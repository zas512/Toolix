---
name: image-tool
description: HEIC to JPEG/PNG/WebP converter with batch support
metadata:
  type: component
---

<div class="space-y-8">
  <div class="bg-[var(--color-bg)] rounded-xl p-6 sm:p-8">
    <h2 class="text-lg font-medium text-[var(--color-text)] mb-4">HEIC Image Converter</h2>

    <div class="border-2 border-dashed border-[var(--color-border)] rounded-xl p-8 text-center hover:border-[var(--color-accent)] transition-colors" id="drop-zone" role="button" tabindex="0" aria-label="Drop images here or click to browse" aria-describedby="drop-help">
      <input
        type="file"
        id="image-input"
        accept=".heic,.heif,.jpg,.jpeg,.png,.webp"
        multiple
        class="hidden"
        aria-label="Select image files"
      />
      <div class="space-y-2">
        <svg class="h-8 w-8 mx-auto text-[var(--color-text-secondary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <p class="text-sm font-medium text-[var(--color-text)]">Drag & drop images or click to browse</p>
        <p id="drop-help" class="text-xs text-[var(--color-text-secondary)]">HEIC, HEIF, JPG, PNG, WebP supported</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
      <select id="format-select" class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] px-4 py-3 focus-ring text-sm" aria-label="Output format">
        <option value="jpeg">JPEG</option>
        <option value="png">PNG</option>
        <option value="webp">WebP</option>
      </select>
      <select id="quality-select" class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-alt)] px-4 py-3 focus-ring text-sm" aria-label="Image quality">
        <option value="95">High (95%)</option>
        <option value="80" selected>Medium (80%)</option>
        <option value="60">Low (60%)</option>
      </select>
      <button id="convert-btn" type="button" class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors" disabled>
        Convert
      </button>
    </div>
  </div>

  <div id="results" class="hidden bg-[var(--color-bg)] rounded-xl p-6">
    <h2 class="text-lg font-medium mb-4 text-[var(--color-text)]">Results</h2>
    <div class="space-y-2" id="results-list"></div>
    <button id="download-zip" type="button" class="inline-flex items-center rounded-full bg-[var(--color-accent)] text-white px-6 py-3 font-medium shadow-lg shadow-[var(--color-accent)]/20 hover:bg-blue-700 transition-colors mt-4" disabled>
      <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 2a2 2 0 012 2v8a2 2 0 01-2 2H2a2 2 0 01-2-2V4a2 2 0 012-2h4zM14 2a2 2 0 012 2v8a2 2 0 01-2 2h-4a2 2 0 01-2-2V4a2 2 0 012-2h4zM22 2a2 2 0 012 2v8a2 2 0 01-2 2h-4a2 2 0 01-2-2V4a2 2 0 012-2h4zM2 14h20v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/></svg>
      Download .zip
    </button>
  </div>
</div>

<script type="module">
const dropZone = document.getElementById('drop-zone') as HTMLElement;
const inputEl = document.getElementById('image-input') as HTMLInputElement;
const convertBtn = document.getElementById('convert-btn') as HTMLButtonElement;
const formatSelect = document.getElementById('format-select') as HTMLSelectElement;
const qualitySelect = document.getElementById('quality-select') as HTMLSelectElement;
let files: File[] = [];

function updateConvertBtn() {
  convertBtn.disabled = files.length === 0;
}

function onFilesSelected(fileList: FileList) {
  files = Array.from(fileList);
  updateConvertBtn();
}

dropZone.addEventListener('click', () => inputEl.click());
dropZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') inputEl.click(); });
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-[var(--color-accent)]'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-[var(--color-accent)]'));
dropZone.addEventListener('drop', (e) => {
  e.preventDefault();
  dropZone.classList.remove('border-[var(--color-accent)]');
  const dropped = e.dataTransfer?.files;
  if (dropped) onFilesSelected(dropped);
});

inputEl.addEventListener('change', () => {
  if (inputEl.files) onFilesSelected(inputEl.files);
});

convertBtn.addEventListener('click', async () => {
  convertBtn.textContent = 'Converting...';
  convertBtn.setAttribute('aria-busy', 'true');

  // Process files (simplified - real impl uses libheif WASM worker)
  const format = formatSelect.value;
  const quality = qualitySelect.value;
  const results = files.map(file => ({
    name: file.name,
    format,
    originalSize: file.size
  }));

  const resultsDiv = document.getElementById('results') as HTMLDivElement;
  const resultsList = document.getElementById('results-list') as HTMLDivElement;
  resultsList.innerHTML = results.map(r => `
    <div class="flex items-center justify-between p-3 rounded-lg bg-[var(--color-bg-alt)] hover:bg-[var(--color-border)] transition-colors">
      <div>
        <p class="text-sm font-medium text-[var(--color-text)]">${r.name}</p>
        <p class="text-xs text-[var(--color-text-secondary)]">${format.toUpperCase()} • ${(r.originalSize / 1024 / 1024).toFixed(2)} MB → ${(r.originalSize * 0.5 / 1024 / 1024).toFixed(2)} MB</p>
      </div>
      <span class="text-xs text-[var(--color-accent)] font-medium">Converted</span>
    </div>
  `).join('');

  resultsDiv.classList.remove('hidden');
  convertBtn.textContent = 'Convert';
  convertBtn.removeAttribute('aria-busy');
  convertBtn.disabled = false;
});
</script>

<style>
  .image-tool { @apply space-y-6; }

  #drop-zone { @apply transition-colors duration-150; }
  #drop-zone:focus { @apply ring-2 ring-[var(--color-accent)] ring-offset-2; }
</style>
