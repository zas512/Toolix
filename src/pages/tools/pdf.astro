---
import Layout from '../../layouts/Layout.astro';
import PdfUtilityTool from '../../components/tools/PdfUtilityTool.astro';
---

<Layout
  title="PDF Tools — Merge, Split, Compress"
  description="Merge, split, and compress PDF files entirely in your browser. Client-side PDF utility with zero uploads."
  canonical="https://toolix.dev/tools/pdf"
>
  <section class="max-w-4xl py-6">
    <h1 class="text-3xl font-bold tracking-tight mb-4 font-display">
      PDF Tools
    </h1>
    <p class="text-lg text-[var(--color-text-secondary)] mb-8 max-w-2xl">
      Merge, split, and compress PDF files entirely in your browser. All processing happens locally using
      pdf-lib and pdf.js — no files ever leave your device.
    </p>

    {/* Tool Interface */}
    <div class="bg-[var(--color-bg-alt)] rounded-2xl p-6 sm:p-8">
      <PdfUtilityTool />
    </div>

    {/* Editorial Wrapper for SEO/AdSense */}
    <div class="mt-16 space-y-8 max-w-3xl">
      <h2 class="text-2xl font-bold font-display">PDF Processing Privacy</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Unlike online PDF services that process your documents on remote servers, Toolix performs all PDF
        operations entirely within your browser. This means:
      </p>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li>Your documents never touch a server</li>
        <li>No file size limits from upload restrictions</li>
        <li>Zero privacy risk for sensitive documents</li>
        <li>Works offline once assets are loaded</li>
      </ul>

      <h3 class="text-xl font-bold font-display pt-4">Supported Operations</h3>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li><strong>Merge:</strong> Combine multiple PDFs into one document</li>
        <li><strong>Split:</strong> Extract specific pages from a PDF</li>
        <li><strong>Compress:</strong> Reduce PDF size by downsampling images and stripping metadata</li>
      </ul>

      <h3 class="text-xl font-bold font-display pt-4">Frequently Asked Questions</h3>
      <div class="space-y-4">
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Can I process password-protected PDFs?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            No. Password-protected PDFs require server-side decryption for security reasons. Our client-only
            architecture prevents this for user privacy protection.
          </p>
        </div>
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">What's the maximum file size?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            File size is limited by your device's memory. For typical documents (5-20 pages), processing
            is instantaneous. Larger files may take longer but remain private.
          </p>
        </div>
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Does it work offline?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Yes! Once the PDF library assets are loaded, all operations work completely offline thanks to
            PWA service worker caching.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
