---
import Layout from '../../layouts/Layout.astro';
import PomodoroTimerTool from '../../components/tools/PomodoroTimerTool.astro';
---

<Layout
  title="Pomodoro Timer — Deep Work Focus Clock"
  description="Deep-work Pomodoro timer with unthrottled Web Worker tick thread. Audio alerts via Web Audio API. Zero uploads."
  canonical="https://toolix.dev/tools/pomodoro"
>
  <section class="max-w-4xl py-6">
    <h1 class="text-3xl font-bold tracking-tight mb-4 font-display">Pomodoro Timer</h1>
    <p class="text-lg text-[var(--color-text-secondary)] mb-8 max-w-2xl">
      Deep-work timer that works even when your tab is hidden. Uses a dedicated Web Worker for
      unthrottled tick intervals and the Web Audio API for alert chimes. Track streaks locally.
    </p>

    <div class="bg-[var(--color-bg-alt)] rounded-2xl p-6 sm:p-8 max-w-xl">
      <PomodoroTimerTool />
    </div>

    <div class="mt-16 space-y-8 max-w-3xl">
      <h2 class="text-2xl font-bold font-display">How the Timer Works</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Standard JavaScript <code>setInterval</code> functions are throttled by browsers to once per minute when the tab is hidden. For a focus timer, this is unacceptable — you'd miss your interval entirely.
      </p>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Our timer solves this with a <strong>Web Worker tick thread</strong>. The worker runs independently of the main browser tab and is not affected by browser throttling policies. The main thread receives precise tick updates and manages the UI.
      </p>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        When your timer completes, the Web Audio API synthesizer generates alert tones — no external audio files required. This keeps the tool lightweight and fully private.
      </p>

      <h3 class="text-xl font-bold font-display pt-4">Features</h3>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li>Unthrottled Web Worker tick thread</li>
        <li>Synthesized Web Audio chimes</li>
        <li>LocalStorage session tracking and streak counters</li>
        <li>Works in hidden/background tabs</li>
        <li>Works offline (PWA)</li>
      </ul>

      <h3 class="text-xl font-bold font-display pt-4">Frequently Asked Questions</h3>
      <div class="space-y-4">
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Does it work when I switch tabs?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">Yes. The Web Worker tick thread continues running independently of tab visibility.</p>
        </div>
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Can I close the tab?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">No — closing the tab kills all Web Workers. Use the timer with the page open (even in background).</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
