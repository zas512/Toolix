---
import Layout from '../../layouts/Layout.astro';
import ImageConverterTool from '../../components/tools/ImageConverterTool.astro';
---

<Layout
  title="HEIC Image Converter — Convert HEIC to JPG, PNG, WebP"
  description="Convert HEIC/HEIF images to JPG, PNG, or WebP in your browser. Uses libheif WASM. Zero uploads."
  canonical="https://toolix.dev/tools/image"
>
  <section class="max-w-4xl py-6">
    <h1 class="text-3xl font-bold tracking-tight mb-4 font-display">
      Image Transcoder
    </h1>
    <p class="text-lg text-[var(--color-text-secondary)] mb-8 max-w-2xl">
      Convert HEIC/HEIF images to JPEG, PNG, or WebP in your browser. Batch processing with .zip export.
      Uses libheif compiled to WebAssembly.
    </p>

    <div class="bg-[var(--color-bg-alt)] rounded-2xl p-6 sm:p-8">
      <ImageConverterTool />
    </div>

    <section class="mt-16 space-y-8 max-w-3xl">
      <h2 class="text-2xl font-bold font-display">How HEIC Conversion Works</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Apple HEIC (High Efficiency Image Container) files use the HEIF standard for image storage.
        This format provides excellent compression but has limited browser support. Our tool uses
        <strong>libheif compiled to WebAssembly</strong> to decode HEIC files entirely in your browser.
      </p>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Once decoded, images are drawn to an <strong>off-screen canvas</strong> and exported to your
        chosen format (JPEG, PNG, or WebP) at the selected quality level. For batch processing, output files
        are bundled into a .zip archive using jszip.
      </p>

      <h3 class="text-xl font-bold font-display pt-4">Supported Formats</h3>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li>Input: HEIC, HEIF (Apple Photos format)</li>
        <li>Output: JPEG, PNG, WebP (user-selected)</li>
        <li>Quality control: Adjustable compression levels</li>
        <li>Batch processing: Drag multiple files simultaneously</li>
        <li>Export: .zip archive with all converted files</li>
      </ul>

      <h3 class="text-xl font-bold font-display pt-4">Frequently Asked Questions</h3>
      <div class="space-y-4">
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Is my image data safe?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Yes. All decoding and conversion happens in your browser using WebAssembly. No images are
            uploaded to any server. Your files remain completely private.
          </p>
        </div>
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Does this work for videos?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            No. This tool is specifically for HEIC/HEIF image files. Video files use different codecs
            and are not supported by this transcoder.
          </p>
        </div>
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Can it work offline?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Yes! Once the WebAssembly module is loaded, all conversion happens locally. The PWA service
            worker caches the library for offline use.
          </p>
        </div>
      </div>
    </section>
  </section>
</Layout>
