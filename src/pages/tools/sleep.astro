---
import Layout from '../../layouts/Layout.astro';
import SleepCalculator from '../../components/tools/SleepCalculator.astro';
---

<Layout
  title="Sleep Cycle Calculator — Optimal Bedtimes & Wake Times"
  description="Calculate optimal bedtimes and wake times based on 90-minute sleep cycles. Client-side circadian calculator. Zero uploads, 100% private."
  canonical="https://toolix.dev/tools/sleep"
>
  <section class="max-w-4xl py-6">
    <h1 class="text-3xl font-bold tracking-tight mb-4 font-display">
      Sleep Cycle Calculator
    </h1>
    <p class="text-lg text-[var(--color-text-secondary)] mb-8 max-w-2xl">
      Based on 90-minute ultradian sleep rhythms, calculate optimal bedtimes and wake times for
      feeling refreshed. Adjust sleep latency and track your sleep consistency over time.
    </p>

    {/* Tool Interface */}
    <div class="bg-[var(--color-bg-alt)] rounded-2xl p-6 sm:p-8">
      <SleepCalculator />
    </div>

    {/* Editorial Wrapper for SEO/AdSense */}
    <div class="mt-16 space-y-8 max-w-3xl">
      <h2 class="text-2xl font-bold font-display">How Sleep Cycles Work</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Human sleep follows <strong>ultradian rhythms</strong> of approximately 90 minutes per cycle.
        Each cycle progresses through light sleep, deep sleep, and REM stages. Waking at the end of a
        cycle (rather than in the middle) leads to feeling more refreshed and less groggy.
      </p>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        The tool below models these cycles and calculates optimal times based on your target wake time
        or bedtime, using a <strong>14-minute average sleep latency</strong> window — the time it typically
        takes to fall asleep after getting into bed.
      </p>

      <h3 class="text-xl font-bold font-display pt-4">Sleep Cycle Basics</h3>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li>A full sleep cycle lasts ~90 minutes</li>
        <li>Typical night includes 4–6 complete cycles</li>
        <li>Waking at cycle endpoints reduces sleep inertia</li>
        <li>14-minute sleep latency window accounts for falling asleep</li>
      </ul>

      <h3 class="text-xl font-bold font-display pt-4">Features</h3>
      <ul class="list-disc list-inside space-y-2 text-[var(--color-text-secondary)]">
        <li>Calculate bedtimes for a target wake time</li>
        <li>Calculate wake times for a target bedtime</li>
        <li>Adjustable sleep latency (default 14 minutes)</li>
        <li>Sleep consistency tracking (localStorage)</li>
        <li>100% client-side, zero uploads</li>
        <li>Works offline (PWA)</li>
      </ul>

      <h3 class="text-xl font-bold font-display pt-4">Frequently Asked Questions</h3>
      <div class="space-y-4">
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Is my data private?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            Yes. All calculations happen entirely in your browser. No sleep data is transmitted to any server.
          </p>
        </div>
        <div class="border-b border-[var(--color-border)] pb-4">
          <h4 class="font-medium mb-1">Are 90-minute cycles accurate for everyone?</h4>
          <p class="text-sm text-[var(--color-text-secondary)]">
            While 90 minutes is the average ultradian rhythm, individual cycles may vary. The tool provides
            optimal estimates — actual feelings may vary based on personal biology, alcohol, caffeine, and
            other factors.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
