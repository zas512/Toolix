---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Toolix — 100% Free Online Tools. No Sign-Up."
  description="Word unscrambler, sleep calculator, PDF utilities, image transcoder, pomodoro timer, typing practice. All client-side. Zero uploads. No account required."
>
  <section class="relative py-12 sm:py-16 lg:py-20">
    <div class="max-w-3xl">
      <h1 class="tracking-tight text-5xl font-bold sm:text-7xl leading-[1.05] mb-8 font-display">
        100% free tools.<br />
        <span class="text-[var(--color-accent)]">Zero uploads.</span>
      </h1>
      <p class="text-xl text-[var(--color-text-secondary)] leading-relaxed mb-10 max-w-2xl">
        Open a page, drop in your data, get the result instantly. Nothing leaves your browser. No accounts. No tracking.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/tools/unscrambler" class="inline-flex items-center rounded-full bg-[var(--color-accent)] text-black font-semibold px-8 py-4 shadow-lg shadow-[var(--color-accent)]/20 hover:opacity-90 transition-all">
          Try Unscrambler
          <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
        <a href="/tools/typing" class="inline-flex items-center rounded-full bg-[var(--color-bg-alt)] border border-[var(--color-border)] text-[var(--color-text)] font-semibold px-8 py-4 hover:bg-[var(--color-border)]/30 transition-all">
          Typing Practice
        </a>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" aria-label="Tool directory">
      <a href="/tools/unscrambler" class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 hover:border-[var(--color-accent)] transition-all">
        <h3 class="text-lg font-semibold mb-1 font-display">Word Unscrambler</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Trie search. Wildcards. Scrabble scores.</p>
      </a>
      <a href="/tools/sleep" class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 hover:border-[var(--color-accent)] transition-all">
        <h3 class="text-lg font-semibold mb-1 font-display">Sleep Calculator</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">90-min cycles. Circadian curves.</p>
      </a>
      <a href="/tools/pdf" class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 hover:border-[var(--color-accent)] transition-all">
        <h3 class="text-lg font-semibold mb-1 font-display">PDF Tools</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Merge, split, compress client-side.</p>
      </a>
      <a href="/tools/image" class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 hover:border-[var(--color-accent)] transition-all">
        <h3 class="text-lg font-semibold mb-1 font-display">HEIC Transcoder</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Batch to JPEG/PNG/WebP. WASM.</p>
      </a>
      <a href="/tools/pomodoro" class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 hover:border-[var(--color-accent)] transition-all">
        <h3 class="text-lg font-semibold mb-1 font-display">Pomodoro Timer</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Worker tick. Web Audio. Streaks.</p>
      </a>
      <a href="/tools/typing" class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-alt)] p-6 hover:border-[var(--color-accent)] transition-all">
        <h3 class="text-lg font-semibold mb-1 font-display">Typing Practice</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Mechanical key audio. WPM tracker. 6 themes.</p>
      </a>
    </div>
  </section>
</Layout>
