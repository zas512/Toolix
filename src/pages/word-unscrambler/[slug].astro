---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { slug: '5-letter-words' } },
    { params: { slug: 'words-starting-with-c' } },
    { params: { slug: 'scrabble-word-finder' } },
    { params: { slug: 'unscramble-letters' } },
    { params: { slug: 'word-unscrambler-free' } },
  ];
}

const { slug } = Astro.params;
---

<Layout
  title={`Word Unscrambler — ${slug}`}
  description={`Find words for '${slug}' with our client-side Trie unscrambler. Zero uploads.`}
  canonical={`https://toolix.dev/word-unscrambler/${slug}`}
>
  <div class="max-w-3xl py-8">
    <h1 class="text-3xl font-bold tracking-tight mb-4 font-display">Unscramble: {slug}</h1>
    <p class="text-lg text-[var(--color-text-secondary)] mb-6">Find words matching the letters in "{slug}" using our client-side Trie search.</p>
    <a href="/tools/unscrambler" class="text-[var(--color-accent)] font-semibold hover:underline">← Back to Unscrambler</a>
  </div>
</Layout>
