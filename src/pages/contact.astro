---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Toolix — Get in Touch"
  description="Contact Toolix. Reach us for support, partnerships, or editorial inquiries."
  canonical="https://toolix.dev/contact"
>
  <div class="max-w-3xl py-8">
    <h1 class="text-4xl font-bold tracking-tight mb-4 font-display">Contact</h1>
    <p class="text-xl text-[var(--color-text-secondary)] mb-8">Have a question, partnership idea, or feedback? Reach out directly.</p>

    <div class="space-y-6 text-[var(--color-text-secondary)] leading-relaxed mb-12">
      <p><strong>Email:</strong> <a href="mailto:hello@toolix.dev" class="text-[var(--color-accent)] hover:underline">hello@toolix.dev</a></p>
      <p>Response time: within 48 hours for all inquiries.</p>
      <p>For editorial questions about tool documentation or accuracy: reference the specific tool page URL in your message.</p>
    </div>
  </div>
</Layout>
