---
name: layout
description: Main layout with header, footer, and tool container
metadata:
  type: project
---

<Layout>
  <Header.astro>
    <div class="relative min-h-16 flex items-center justify-between px-6 py-2 sm:px-12">
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2 text-xl font-medium text-[var(--color-text)]">
          <img src="/favicon.svg" alt="Toolix" class="h-8 w-8" />
          <span class="hidden sm:inline-block">Toolix</span>
        </a>
        <div class="flex items-center gap-2">
          <div class="relative" aria-label="Theme toggle">
            <button
              type="button"
              class="flex h-8 w-8 items-center justify-center rounded-full focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-accent)]"
              aria-pressed="false"
              data-theme="auto"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 2a8 8 0 100 16 8 8 0 000-16Zm1 15a5 5 0 11-10 0 5 5 0 0110 0Z" />
              </svg>
            </button>
          </div>
          <a href="/search" class="text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-accent)]">
            Search
          </a>
        </div>
      </div>
    </div>
  </Header.astro>

  <main class="flex-1 min-h-[calc(100vh-160px)] px-6 py-8 sm:px-12">
    <slot />
  </main>

  <Footer.astro>
    <footer class="mt-12 py-12 border-t border-[var(--color-border)] text-sm text-[var(--color-text-secondary)]">
      <div class="container mx-auto px-6">
        <div class="flex flex-col sm:flex-row justify-between items-center">
          <div class="space-y-4 sm:flex-row sm:space-x-6">
            <a href="/about" class="text-[var(--color-text)] hover:text-[var(--color-accent)]">
              About
            </a>
            <a href="/contact" class="text-[var(--color-text)] hover:text-[var(--color-accent)]">
              Contact
            </a>
            <a href="/terms" class="text-[var(--color-text)] hover:text-[var(--color-accent)]">
              Terms
            </a>
            <a href="/privacy" class="text-[var(--color-text)] hover:text-[var(--color-accent)]">
              Privacy
            </a>
          </div>
          <div class="mt-4 sm:mt-0">
            <span class="text-[var(--color-text)]">
              © 2026 Toolix. All rights reserved.
            </span>
          </div>
        </div>
      </div>
    </footer>
  </Footer.astro>
</Layout>